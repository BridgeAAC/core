{
  "$schema": "https://raw.githubusercontent.com/electron-userland/electron-builder/master/packages/app-builder-lib/scheme.json",
  "appId": "org.bridgeaac.app",
  "productName": "BridgeAAC",
  "copyright": "Copyright © BridgeAAC Contributors (bridgeaac.org)",
  "electronVersion": "35.0.0",
  "npmRebuild": false,
  "directories": {
    "output": "release"
  },
  "files": [
    "dist/**/*",
    "electron/**/*",
    "!node_modules/**/*"
  ],
  "fileAssociations": [
    {
      "ext": "ce",
      "name": "AAC Vocabulary File",
      "description": "AAC Vocabulary Export (.ce)",
      "role": "Editor"
    },
    {
      "ext": "bridge",
      "name": "BridgeAAC Vocabulary File",
      "description": "BridgeAAC Vocabulary Backup (.bridge)",
      "role": "Editor"
    },
    {
      "ext": "obz",
      "name": "Open Board Format Archive",
      "description": "Open Board Format Package (.obz)",
      "role": "Editor"
    },
    {
      "ext": "obf",
      "name": "Open Board Format File",
      "description": "Open Board Format Board (.obf)",
      "role": "Editor"
    }
  ],
  "win": {
    "target": [
      "nsis",
      "portable"
    ],
    "icon": "public/icon-512.png"
  },
  "nsis": {
    "artifactName": "BridgeAAC-Windows-Setup.${ext}",
    "oneClick": false,
    "allowToChangeInstallationDirectory": true,
    "createDesktopShortcut": true,
    "createStartMenuShortcut": true
  },
  "portable": {
    "artifactName": "BridgeAAC-Windows-Portable.${ext}"
  },
  "linux": {
    "artifactName": "BridgeAAC-Linux.${ext}",
    "target": [
      "AppImage",
      "deb"
    ],
    "maintainer": "BridgeAAC <support@bridgeaac.org>",
    "category": "Education;Accessibility;AudioVideo;",
    "icon": "public/icon-512.png",
    "synopsis": "Free, offline-first AAC voice communication app"
  },
  "mac": {
    "artifactName": "BridgeAAC-macOS.${ext}",
    "target": [
      "dmg",
      "zip"
    ],
    "category": "public.app-category.education",
    "icon": "public/icon-512.png"
  }
}
