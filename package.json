{
  "name": "bridgeaac",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "homepage": "https://bridgeaac.org",
  "main": "electron/main.cjs",
  "author": "BridgeAAC (https://bridgeaac.org)",
  "license": "GPL-3.0-or-later",
  "description": "Free, open-source, offline AAC communication app compatible with TouchChat .ce and Open Board Format files.",
  "scripts": {
    "postinstall": "node scripts/patch-deps.mjs",
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "desktop:start": "vite build && electron .",
    "desktop:build:linux": "vite build && electron-builder --linux --config electron-builder.json",
    "desktop:build:win": "vite build && electron-builder --win --config electron-builder.json",
    "desktop:build:mac": "vite build && electron-builder --mac --config electron-builder.json",
    "android:init": "vite build && cap add android && cap sync android",
    "android:build": "vite build && cap sync android && cd android && ./gradlew assembleDebug"
  },
  "dependencies": {
    "@diffusionstudio/vits-web": "^1.0.3",
    "@preact/preset-vite": "^2.10.6",
    "@preact/signals": "^2.11.4",
    "@types/sql.js": "^1.4.11",
    "fflate": "^0.8.3",
    "jsdom": "^30.1.3",
    "mespeak": "^2.0.2",
    "preact": "^11.1.0",
    "sql.js": "^1.15.2",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vite-plugin-pwa": "^2.0.0",
    "vitest": "^5.0.5"
  }
}
